<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <AssemblyName>Orion</AssemblyName>
    <RootNamespace>Orion</RootNamespace>
    <Version>0.1.0</Version>
    <DalamudLibPath>$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>

    <!--
      Pin the output directory. The solution declares an x64 platform, so a solution build lands
      in bin/x64/<Config>/ while a bare project build lands in bin/<Config>/, and Dalamud's
      dev-plugin entry points at exactly one of those. (Same pin as Demeter, Theseus, Odysseus.)
    -->
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!--
    Where the hunt log's mobs stand: FFXIV Teamcraft's player-reported positions (MIT), trimmed to
    hunt-log mobs and grouped into spots by Tools/import_teamcraft_monsters.py. Modified from the
    original, so the licence travels beside it. See NOTICE.md.
  -->
  <ItemGroup>
    <Content Include="Assets\hunt-positions.json" Condition="Exists('Assets\hunt-positions.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Teamcraft's drop-sources.json, verbatim: which items mobs drop, for the item search. -->
    <Content Include="Assets\teamcraft-drop-sources.json" Condition="Exists('Assets\teamcraft-drop-sources.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\licenses\MIT-ffxiv-teamcraft.txt" Condition="Exists('..\licenses\MIT-ffxiv-teamcraft.txt')">
      <Link>licenses\MIT-ffxiv-teamcraft.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\NOTICE.md" Condition="Exists('..\NOTICE.md')">
      <Link>NOTICE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Allow the test assembly to access internal types -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Orion.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Dev-plugin reload race (same fix as Charon, Odysseus and Demeter): touch the DLL after the
    packager has written the manifest, so Dalamud's watcher always finds a complete Orion.json.
  -->
  <Target Name="TouchAssemblyAfterPackaging"
          AfterTargets="DefaultDalamudPackagerDebug;DefaultDalamudPackagerRelease">
    <Touch Files="$(TargetPath)" />
  </Target>

</Project>
